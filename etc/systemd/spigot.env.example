# Overrides and secrets for the spigot service.
#
# Installed by `make deploy/systemd` to /etc/spigot/spigot.env if that file does
# not already exist. Deploys never overwrite it, so edit the copy on the server.
# Values here win over the Environment= lines in spigot.service.
#
# Systemd parses this file itself: no quoting rules beyond KEY=value, no shell
# expansion, no `export`.

# NODE_ENV=production
# DATABASE_FILE_PATH=/var/lib/spigot/database.sqlite
